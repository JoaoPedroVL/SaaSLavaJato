# =============================================================
# Supabase — copie para .env.local e preencha
# Dashboard > Project Settings > API
# =============================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública — pode ir para o navegador (protegida pelo RLS)
SUPABASE_ANON_KEY=

# Chave secreta — NUNCA no navegador, NUNCA commitada
SUPABASE_SERVICE_ROLE_KEY=

# Referência do projeto (o pedaço antes de .supabase.co)
SUPABASE_PROJECT_REF=
